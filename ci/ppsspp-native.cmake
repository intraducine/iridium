# Reuse upstream's complete native iOS target, replacing only its app entry point.
function(iridium_native_psp)
  if(NOT USE_FFMPEG)
    message(FATAL_ERROR "The native PSP player requires upstream FFmpeg media support")
  endif()
  get_target_property(native_sources PPSSPP SOURCES)
  list(FILTER native_sources INCLUDE REGEX "\\.(c|cpp|cc|m|mm|S)$")
  get_target_property(native_libraries PPSSPP LINK_LIBRARIES)
  set(mvk_original "${CMAKE_CURRENT_SOURCE_DIR}/ios/MoltenVK/MoltenVK.xcframework/ios-arm64/libMoltenVK.a")
  list(FIND native_libraries "${mvk_original}" mvk_index)
  if(mvk_index EQUAL -1 OR NOT EXISTS "${IRIDIUM_MOLTENVK_ARCHIVE}")
    message(FATAL_ERROR "The source-built MoltenVK link input is missing")
  endif()
  list(REMOVE_ITEM native_libraries "${mvk_original}")
  list(APPEND native_libraries "${IRIDIUM_MOLTENVK_ARCHIVE}")
  target_include_directories(native PRIVATE "${IRIDIUM_NATIVE_HEADERS}")
  target_include_directories(Core PRIVATE "${IRIDIUM_NATIVE_HEADERS}")
  target_include_directories(Common PRIVATE "${IRIDIUM_NATIVE_HEADERS}")
  target_compile_definitions(Core PRIVATE IRIDIUM_PSP_PREPARED_JIT=1)
  target_compile_definitions(Common PRIVATE IRIDIUM_PSP_PREPARED_JIT=1)
  target_compile_definitions(native PRIVATE IRIDIUM_PSP_PREPARED_JIT=1)
  target_compile_definitions(native PRIVATE AppDelegate=IRPPSSPPAppDelegate SceneDelegate=IRPPSSPPSceneDelegate)
  set_source_files_properties(ios/ViewControllerCommon.mm PROPERTIES COMPILE_FLAGS "-fobjc-arc")
  add_library(IridiumPPSSPPNative SHARED ${native_sources} "${IRIDIUM_NATIVE_ADAPTER}" "${IRIDIUM_NATIVE_HEADERS}/IRPPSSPPCodecCheck.c" "${IRIDIUM_NATIVE_HEADERS}/IRAudioVolume.c" "${IRIDIUM_NATIVE_HEADERS}/IRJITExecutionProbe.c" "${IRIDIUM_NATIVE_HEADERS}/IRPSPExecutableMemory.cpp")
  target_include_directories(IridiumPPSSPPNative PRIVATE "${IRIDIUM_NATIVE_HEADERS}")
  target_link_libraries(IridiumPPSSPPNative PRIVATE ${native_libraries})
  target_compile_definitions(IridiumPPSSPPNative PRIVATE USE_FFMPEG=1 IRIDIUM_PSP_PREPARED_JIT=1 AppDelegate=IRPPSSPPAppDelegate SceneDelegate=IRPPSSPPSceneDelegate)
  set_source_files_properties("${IRIDIUM_NATIVE_ADAPTER}" PROPERTIES COMPILE_FLAGS "-fobjc-arc")
  set_target_properties(IridiumPPSSPPNative PROPERTIES
    MACOSX_RPATH ON INSTALL_NAME_DIR "@rpath" CXX_VISIBILITY_PRESET hidden VISIBILITY_INLINES_HIDDEN ON)
  target_link_options(IridiumPPSSPPNative PRIVATE "-Wl,-exported_symbols_list,${IRIDIUM_NATIVE_EXPORTS}")
endfunction()
cmake_language(DEFER CALL iridium_native_psp)
