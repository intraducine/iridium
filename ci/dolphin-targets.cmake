target_compile_options(core PRIVATE -ffp-model=strict)
target_compile_options(common PRIVATE -ffp-model=strict)
get_target_property(common_sources common SOURCES)
list(REMOVE_ITEM common_sources MemoryUtil_iOS_LuckTXM.cpp)
set_property(TARGET common PROPERTY SOURCES "${common_sources}")
target_sources(common PRIVATE "${IRIDIUM_PHASE3_GENERATED}/MemoryUtil_iOS_LuckTXM.cpp")
get_target_property(core_sources core SOURCES)
list(REMOVE_ITEM core_sources State.cpp)
set_property(TARGET core PROPERTY SOURCES "${core_sources}")
target_sources(core PRIVATE "${IRIDIUM_PHASE3_GENERATED}/State.cpp")
get_target_property(audio_sources audiocommon SOURCES)
list(REMOVE_ITEM audio_sources CoreAudioSoundStream.cpp)
set_property(TARGET audiocommon PROPERTY SOURCES "${audio_sources}")
target_sources(audiocommon PRIVATE "${IRIDIUM_PHASE3_GENERATED}/CoreAudioSoundStream.cpp")
foreach(tls_target mbedtls mbedx509 mbedcrypto)
  target_compile_definitions(${tls_target} PUBLIC
    "MBEDTLS_USER_CONFIG_FILE=\"${IRIDIUM_PHASE3_GENERATED}/mbedtls-user-config.h\"")
endforeach()
get_target_property(metal_sources videometal SOURCES)
list(REMOVE_ITEM metal_sources MTLUtil.mm)
set_property(TARGET videometal PROPERTY SOURCES "${metal_sources}")
target_sources(videometal PRIVATE "${IRIDIUM_PHASE3_GENERATED}/MTLUtil.mm")
target_include_directories(videometal PRIVATE "${CMAKE_SOURCE_DIR}/Source/Core/VideoBackends/Metal")
target_sources(dolphin PRIVATE "${bridge}/IRDolphin.mm" "${bridge}/IRJITExecutionProbe.c")
target_include_directories(dolphin PRIVATE "${bridge}" "${CMAKE_SOURCE_DIR}/Source/iOS/Library")
set_source_files_properties("${bridge}/IRDolphin.mm" TARGET_DIRECTORY dolphin PROPERTIES COMPILE_OPTIONS "-fobjc-arc")
target_link_libraries(dolphin PRIVATE "-framework UIKit" "-framework MetalKit" "-framework CoreGraphics")
target_link_options(dolphin PRIVATE "-Wl,-exported_symbols_list,${IRIDIUM_PHASE3_GENERATED}/native.exports")
set_target_properties(dolphin PROPERTIES OUTPUT_NAME IridiumDolphin INSTALL_NAME_DIR "@rpath" BUILD_WITH_INSTALL_RPATH TRUE)
