@@ -0,0 +1,230 @@
+using Ryujinx.Common.Configuration;
+using Ryujinx.Common.Configuration.Hid;
+using Ryujinx.Common.Logging;
+using Ryujinx.Cpu.LightningJit;
+using Ryujinx.HLE.HOS.SystemState;
+using Ryujinx.Input.Native;
+using Ryujinx.Memory;
+using System;
+using System.IO;
+using System.IO.Compression;
+using LibHac.Common.Keys;
+using System.Collections.Generic;
+using System.Runtime.InteropServices;
+using System.Threading;
+
+namespace Ryujinx.Library
+{
+    partial class Library
+    {
+        internal static bool EmbeddedRun { get; private set; }
+        internal static volatile bool EmbeddedStop;
+        internal static volatile bool EmbeddedPaused;
+        private static volatile float _embeddedVolume = 1f;
+        private static unsafe delegate* unmanaged[Cdecl]<void> _embeddedFrame;
+        private static unsafe delegate* unmanaged[Cdecl]<void> _embeddedInput;
+        private static unsafe delegate* unmanaged[Cdecl]<nint, void> _embeddedDiagnostic;
+        private static int _embeddedStarted, _embeddedBootError;
+        private static long _nextHeadroomCheck;
+
+        private static int EmbeddedBootError(string message)
+        {
+            if (message.Contains("Missing Switch decryption keys", StringComparison.OrdinalIgnoreCase))
+                return -6;
+            if (message.Contains("Could not find Main NCA", StringComparison.OrdinalIgnoreCase) ||
+                message.Contains("Selected NCA file is not a", StringComparison.OrdinalIgnoreCase))
+                return -7;
+            if (message.Contains("decrypt", StringComparison.OrdinalIgnoreCase))
+                return -8;
+            if (message.Contains("missing firmware", StringComparison.OrdinalIgnoreCase))
+                return -9;
+            return 0;
+        }
+
+        private static void ObserveEmbeddedBootError(object sender, LogEventArgs args)
+        {
+            if (args.Level != LogLevel.Error)
+                return;
+            int error = EmbeddedBootError(args.Message);
+            if (error != 0)
+                Interlocked.CompareExchange(ref _embeddedBootError, error, 0);
+        }
+
+        internal static unsafe void EmbeddedReport(string message)
+        {
+            if (_embeddedDiagnostic == null)
+                return;
+            nint text = Marshal.StringToCoTaskMemUTF8(message);
+            try { _embeddedDiagnostic(text); }
+            finally { Marshal.FreeCoTaskMem(text); }
+        }
+
+        [UnmanagedCallersOnly(EntryPoint = "iridium_melonx_install_firmware")]
+        public static unsafe int InstallEmbeddedFirmware(nint dataRoot, nint frameworks, nint file)
+        {
+            try
+            {
+                string path = Marshal.PtrToStringUTF8(file);
+                FileInfo source = new(path);
+                const long limit = 1024L * 1024 * 1024;
+                if (!source.Exists || source.Extension != ".zip" || source.Length > limit)
+                    return 2;
+                using (ZipArchive zip = ZipFile.OpenRead(path))
+                {
+                    long total = 0;
+                    HashSet<string> ids = new(StringComparer.OrdinalIgnoreCase);
+                    if (zip.Entries.Count == 0 || zip.Entries.Count > 1024)
+                        return 2;
+                    foreach (ZipArchiveEntry entry in zip.Entries)
+                    {
+                        string name = entry.FullName;
+                        string id = name.EndsWith(".cnmt.nca", StringComparison.Ordinal) ? name[..^9] :
+                            name.EndsWith(".nca", StringComparison.Ordinal) ? name[..^4] : "";
+                        if (id.Length != 32 || !IsHex(id) || !ids.Add(id) ||
+                            entry.Length <= 0 || entry.Length > limit / 4 || entry.Length > limit - total)
+                            return 2;
+                        total += entry.Length;
+                    }
+                }
+                if (InitializeHost(dataRoot, frameworks, null) != 0)
+                    return 1;
+                if (_contentManager.VerifyFirmwarePackage(path) == null)
+                    return 2;
+                _contentManager.InstallFirmware(path, atomic: true);
+                return 0;
+            }
+            catch (MissingKeyException) { return 3; }
+            catch (InvalidDataException) { return 2; }
+            catch (Exception) { return 4; }
+
+            static bool IsHex(string value)
+            {
+                foreach (char c in value)
+                    if (!Uri.IsHexDigit(c))
+                        return false;
+                return true;
+            }
+        }
+
+        [UnmanagedCallersOnly(EntryPoint = "iridium_melonx_run")]
+        public static unsafe int RunEmbedded(nint file, nint layer,
+            delegate* unmanaged[Cdecl]<nuint, nint*, nint*, byte> allocate,
+            delegate* unmanaged[Cdecl]<nint, nuint, byte> release,
+            delegate* unmanaged[Cdecl]<void> frame, delegate* unmanaged[Cdecl]<void> input, int resolution, uint flags)
+        {
+            if (!embeddedInitializationAttempted || layer == 0 || allocate == null ||
+                release == null || frame == null || input == null ||
+                Interlocked.Exchange(ref _embeddedStarted, 1) != 0)
+                return -1;
+
+            try
+            {
+                EmbeddedRun = true;
+                if (EmbeddedStop)
+                    return 0;
+                string path = Marshal.PtrToStringUTF8(file);
+                if (!File.Exists(path))
+                    return -1;
+
+                DualMappedJitAllocator.HostAllocate = allocate;
+                DualMappedJitAllocator.HostRelease = release;
+                if (!DualMappedMemory.InitMemoryCache())
+                {
+                    EmbeddedReport("MeloNX could not initialize its executable cache.");
+                    return -2;
+                }
+
+                nativeMetalLayer = layer;
+                _embeddedFrame = frame;
+                _embeddedInput = input;
+                Logger.Updated += ObserveEmbeddedBootError;
+                bool loaded = Load(new Options
+                {
+                    InputPath = path,
+                    GraphicsBackend = GraphicsBackend.Vulkan,
+                    BackendThreading = BackendThreading.On,
+                    MemoryManagerMode = MemoryManagerMode.HostMappedUnsafe,
+                    AspectRatio = AspectRatio.Fixed16x9,
+                    ScalingFilter = ScalingFilter.Bilinear,
+                    ResScale = Math.Clamp(resolution, 1, 3),
+                    MaxAnisotropy = -1f,
+                    SystemRegion = RegionCode.USA,
+                    SystemLanguage = SystemLanguage.AmericanEnglish,
+                    SystemTimeZone = TimeZoneInfo.Local.Id,
+                    VSyncMode = VSyncMode.Switch,
+                    CustomVSyncInterval = 120,
+                    DisableDockedMode = (flags & 1) == 0,
+                    DisableVSync = (flags & 2) != 0,
+                    DisableShaderCache = (flags & 4) == 0,
+                    EnableTextureRecompression = (flags & 8) == 0,
+                    EnableHostMemoryBudgetTracking = true,
+                    ExclusiveFullscreenWidth = 1280,
+                    ExclusiveFullscreenHeight = 720,
+                    AudioVolume = _embeddedVolume,
+                    LoggingEnableError = true
+                });
+                if (loaded)
+                    return 0;
+                int error = Volatile.Read(ref _embeddedBootError);
+                return error != 0 ? error : -3;
+            }
+            catch (MissingKeyException) { return -6; }
+            catch (Exception e)
+            {
+                int error = EmbeddedBootError(e.Message);
+                if (error != 0)
+                    return error;
+                EmbeddedReport($"MeloNX launch or shutdown failed: {e.GetType().Name}.");
+                return -4;
+            }
+            finally
+            {
+                Logger.Updated -= ObserveEmbeddedBootError;
+                nativeMetalLayer = 0;
+                _embeddedFrame = null;
+                _embeddedInput = null;
+            }
+        }
+
+        [UnmanagedCallersOnly(EntryPoint = "iridium_melonx_set_state")]
+        public static void SetEmbeddedState(byte stop, byte pause, float volume)
+        {
+            if (stop != 0)
+                EmbeddedStop = true;
+            EmbeddedPaused = pause != 0;
+            _embeddedVolume = volume;
+        }
+
+        internal static unsafe void EmbeddedFrame() => _embeddedFrame();
+
+        internal static unsafe void UpdateEmbedded(WindowBase window)
+        {
+            long now = Environment.TickCount64;
+            if (now >= _nextHeadroomCheck)
+            {
+                _nextHeadroomCheck = now + 2000;
+                ulong headroom = HostMemoryBudget.AvailableBytes;
+                const ulong MiB = 1024 * 1024;
+                if (headroom > 0 && headroom < 640 * MiB)
+                    MemoryPressureMonitor.ReportPressure(headroom <= 256 * MiB
+                        ? MemoryPressureLevel.Critical : MemoryPressureLevel.Warning);
+            }
+
+            bool paused = EmbeddedPaused;
+            if (window._isPaused != paused)
+            {
+                window.Device.System.TogglePauseEmulation(paused);
+                window._isPaused = paused;
+                if (paused)
+                    window._pauseEvent.Reset();
+                else
+                    window._pauseEvent.Set();
+            }
+            float volume = _embeddedVolume;
+            if (window.Device.GetVolume() != volume)
+                window.Device.SetVolume(volume);
+            if (!paused)
+                _embeddedInput();
+        }
+    }
+}
