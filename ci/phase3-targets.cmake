set(bridge "${IRIDIUM_ROOT}/iridium/apps/ios/RuntimeBridge")
if(TARGET dolphin)
  foreach(tls_target mbedtls mbedx509 mbedcrypto)
    target_compile_definitions(${tls_target} PUBLIC
      "MBEDTLS_USER_CONFIG_FILE=\"${IRIDIUM_PHASE3_GENERATED}/mbedtls-user-config.h\"")
  endforeach()
  target_sources(dolphin PRIVATE "${bridge}/IRDolphin.mm")
  target_include_directories(dolphin PRIVATE "${bridge}" "${CMAKE_SOURCE_DIR}/Source/iOS/Library")
  set_source_files_properties("${bridge}/IRDolphin.mm" PROPERTIES COMPILE_OPTIONS "-fobjc-arc")
  target_link_libraries(dolphin PRIVATE "-framework UIKit" "-framework MetalKit" "-framework CoreGraphics")
  target_link_options(dolphin PRIVATE "-Wl,-exported_symbols_list,${IRIDIUM_PHASE3_GENERATED}/native.exports")
  set_target_properties(dolphin PROPERTIES OUTPUT_NAME IridiumDolphin INSTALL_NAME_DIR "@rpath" BUILD_WITH_INSTALL_RPATH TRUE)
elseif(TARGET citra_libretro)
  target_link_options(citra_libretro PRIVATE "-Wl,-exported_symbols_list,${IRIDIUM_PHASE3_GENERATED}/retro.exports")
  set_target_properties(citra_libretro PROPERTIES INSTALL_NAME_DIR "@rpath" BUILD_WITH_INSTALL_RPATH TRUE)
elseif(TARGET play_libretro)
  get_target_property(sources play_libretro SOURCES)
  list(REMOVE_ITEM sources main_libretro.cpp)
  set_property(TARGET play_libretro PROPERTY SOURCES "${sources}")
  target_sources(play_libretro PRIVATE "${IRIDIUM_PHASE3_GENERATED}/main_libretro.cpp" "${bridge}/IRPlayProbe.cpp" "${bridge}/IRJITExecutionProbe.c")
  target_include_directories(play_libretro PRIVATE "${bridge}" "${CMAKE_SOURCE_DIR}/Source/ui_libretro")
  get_target_property(sources CodeGen SOURCES)
  list(REMOVE_ITEM sources src/MemoryFunction.cpp)
  set_property(TARGET CodeGen PROPERTY SOURCES "${sources}")
  target_sources(CodeGen PRIVATE "${IRIDIUM_PHASE3_GENERATED}/MemoryFunction.cpp")
  target_link_options(play_libretro PRIVATE "-Wl,-exported_symbols_list,${IRIDIUM_PHASE3_GENERATED}/retro.exports")
elseif(TARGET flycast_libretro)
  get_target_property(sources flycast_libretro SOURCES)
  list(REMOVE_ITEM sources core/deps/libretro-common/glsm/glsm.c)
  set_property(TARGET flycast_libretro PROPERTY SOURCES "${sources}")
  target_sources(flycast_libretro PRIVATE "${IRIDIUM_PHASE3_GENERATED}/glsm.c")
  target_sources(flycast_libretro PRIVATE "${bridge}/IRFlycastProbe.cpp" "${bridge}/IRJITExecutionProbe.c")
  target_include_directories(flycast_libretro PRIVATE "${bridge}")
  target_link_options(flycast_libretro PRIVATE "-Wl,-exported_symbols_list,${IRIDIUM_PHASE3_GENERATED}/retro.exports")
endif()
