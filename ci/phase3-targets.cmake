set(bridge "${IRIDIUM_ROOT}/iridium/apps/ios/RuntimeBridge")
if(TARGET dolphin)
  target_compile_options(core PRIVATE -ffp-model=strict)
  target_compile_options(common PRIVATE -ffp-model=strict)
  get_target_property(common_sources common SOURCES)
  list(REMOVE_ITEM common_sources MemoryUtil_iOS_LuckTXM.cpp)
  set_property(TARGET common PROPERTY SOURCES "${common_sources}")
  target_sources(common PRIVATE "${IRIDIUM_PHASE3_GENERATED}/MemoryUtil_iOS_LuckTXM.cpp")
  get_target_property(core_sources core SOURCES)
  list(REMOVE_ITEM core_sources State.cpp)
  set_property(TARGET core PROPERTY SOURCES "${core_sources}")
  target_sources(core PRIVATE "${IRIDIUM_PHASE3_GENERATED}/State.cpp")
  get_target_property(audio_sources audiocommon SOURCES)
  list(REMOVE_ITEM audio_sources CoreAudioSoundStream.cpp)
  set_property(TARGET audiocommon PROPERTY SOURCES "${audio_sources}")
  target_sources(audiocommon PRIVATE "${IRIDIUM_PHASE3_GENERATED}/CoreAudioSoundStream.cpp")
  foreach(tls_target mbedtls mbedx509 mbedcrypto)
    target_compile_definitions(${tls_target} PUBLIC
      "MBEDTLS_USER_CONFIG_FILE=\"${IRIDIUM_PHASE3_GENERATED}/mbedtls-user-config.h\"")
  endforeach()
  get_target_property(metal_sources videometal SOURCES)
  list(REMOVE_ITEM metal_sources MTLUtil.mm)
  set_property(TARGET videometal PROPERTY SOURCES "${metal_sources}")
  target_sources(videometal PRIVATE "${IRIDIUM_PHASE3_GENERATED}/MTLUtil.mm")
  target_include_directories(videometal PRIVATE "${CMAKE_SOURCE_DIR}/Source/Core/VideoBackends/Metal")
  target_sources(dolphin PRIVATE "${bridge}/IRDolphin.mm" "${bridge}/IRJITExecutionProbe.c")
  target_include_directories(dolphin PRIVATE "${bridge}" "${CMAKE_SOURCE_DIR}/Source/iOS/Library")
  set_source_files_properties("${bridge}/IRDolphin.mm" TARGET_DIRECTORY dolphin PROPERTIES COMPILE_OPTIONS "-fobjc-arc")
  target_link_libraries(dolphin PRIVATE "-framework UIKit" "-framework MetalKit" "-framework CoreGraphics")
  target_link_options(dolphin PRIVATE "-Wl,-exported_symbols_list,${IRIDIUM_PHASE3_GENERATED}/native.exports")
  set_target_properties(dolphin PROPERTIES OUTPUT_NAME IridiumDolphin INSTALL_NAME_DIR "@rpath" BUILD_WITH_INSTALL_RPATH TRUE)
elseif(TARGET citra_libretro)
  foreach(target dynarmic citra_core video_core citra_libretro)
    target_include_directories(${target} BEFORE PRIVATE "${IRIDIUM_PHASE3_GENERATED}/include" "${bridge}")
  endforeach()
  get_target_property(sources dynarmic SOURCES)
  list(FILTER sources EXCLUDE REGEX "(^|/)(address_space[.]cpp|spin_lock_arm64[.]cpp|exception_handler_macos[.]cpp|exception_handler_macos_mig[.]c|exception_handler_generic[.]cpp)$")
  set_property(TARGET dynarmic PROPERTY SOURCES "${sources}")
  # The shared debugger owns exception handling. Dynarmic uses its checked-memory path.
  target_sources(dynarmic PRIVATE "${IRIDIUM_PHASE3_GENERATED}/spin_lock_arm64.cpp" "${IRIDIUM_PHASE3_GENERATED}/address_space.cpp" "${CMAKE_SOURCE_DIR}/externals/dynarmic/src/dynarmic/backend/exception_handler_generic.cpp")
  get_target_property(sources citra_core SOURCES)
  list(REMOVE_ITEM sources arm/dynarmic/arm_dynarmic.cpp)
  set_property(TARGET citra_core PROPERTY SOURCES "${sources}")
  target_sources(citra_core PRIVATE "${IRIDIUM_PHASE3_GENERATED}/arm_dynarmic.cpp")
  get_target_property(sources video_core SOURCES)
  list(REMOVE_ITEM sources shader/shader_jit.cpp shader/shader_jit_a64_compiler.cpp)
  list(FILTER sources EXCLUDE REGEX "renderer_vulkan/vk_(platform|present_window|swapchain)[.]cpp")
  set_property(TARGET video_core PROPERTY SOURCES "${sources}")
  get_target_property(definitions video_core COMPILE_DEFINITIONS)
  list(REMOVE_ITEM definitions HAVE_LIBRETRO)
  set_property(TARGET video_core PROPERTY COMPILE_DEFINITIONS "${definitions}")
  # Use Azahar's main renderer and presentation queue with an iOS Metal surface.
  target_sources(video_core PRIVATE "${IRIDIUM_PHASE3_GENERATED}/shader_jit.cpp" "${IRIDIUM_PHASE3_GENERATED}/shader_jit_a64_compiler.cpp"
    "${IRIDIUM_PHASE3_GENERATED}/vk_platform.cpp"
    "${CMAKE_SOURCE_DIR}/src/video_core/renderer_vulkan/vk_present_window.cpp"
    "${CMAKE_SOURCE_DIR}/src/video_core/renderer_vulkan/vk_swapchain.cpp")
  get_target_property(sources citra_libretro_common SOURCES)
  list(FILTER sources EXCLUDE REGEX "libretro_vk[.]cpp|libretro_window[.]cpp|mouse_tracker[.]cpp")
  set_property(TARGET citra_libretro_common PROPERTY SOURCES "${sources}")
  target_sources(citra_libretro_common PRIVATE "${IRIDIUM_PHASE3_GENERATED}/libretro_window.cpp" "${IRIDIUM_PHASE3_GENERATED}/mouse_tracker.cpp")
  get_target_property(sources citra_libretro SOURCES)
  list(REMOVE_ITEM sources citra_libretro.cpp)
  set_property(TARGET citra_libretro PROPERTY SOURCES "${sources}")
  target_sources(citra_libretro PRIVATE "${IRIDIUM_PHASE3_GENERATED}/citra_libretro.cpp"
    "${bridge}/IRAzaharJIT.cpp" "${bridge}/IRAzaharGraphics.mm" "${bridge}/IRJITExecutionProbe.c")
  set_source_files_properties("${bridge}/IRAzaharGraphics.mm" TARGET_DIRECTORY citra_libretro PROPERTIES COMPILE_OPTIONS "-fobjc-arc")
  target_link_libraries(citra_libretro PRIVATE "${IRIDIUM_AZAHAR_MOLTENVK}" "-framework Metal" "-framework QuartzCore" "-framework CoreGraphics" "-framework UIKit")
  target_link_options(citra_libretro PRIVATE "-Wl,-exported_symbols_list,${IRIDIUM_PHASE3_GENERATED}/retro.exports")
  set_target_properties(citra_libretro PROPERTIES INSTALL_NAME_DIR "@rpath" BUILD_WITH_INSTALL_RPATH TRUE)
elseif(TARGET play_libretro)
  get_target_property(sources play_libretro SOURCES)
  list(REMOVE_ITEM sources main_libretro.cpp)
  set_property(TARGET play_libretro PROPERTY SOURCES "${sources}")
  target_sources(play_libretro PRIVATE "${IRIDIUM_PHASE3_GENERATED}/main_libretro.cpp" "${bridge}/IRPlayProbe.cpp" "${bridge}/IRJITExecutionProbe.c")
  target_include_directories(play_libretro PRIVATE "${bridge}" "${CMAKE_SOURCE_DIR}/Source/ui_libretro")
  get_target_property(sources CodeGen SOURCES)
  list(REMOVE_ITEM sources src/MemoryFunction.cpp)
  set_property(TARGET CodeGen PROPERTY SOURCES "${sources}")
  target_sources(CodeGen PRIVATE "${IRIDIUM_PHASE3_GENERATED}/MemoryFunction.cpp")
  target_link_options(play_libretro PRIVATE "-Wl,-exported_symbols_list,${IRIDIUM_PHASE3_GENERATED}/retro.exports")
elseif(TARGET flycast_libretro)
  get_target_property(sources flycast_libretro SOURCES)
  list(REMOVE_ITEM sources core/deps/libretro-common/glsm/glsm.c)
  list(REMOVE_ITEM sources shell/libretro/libretro.cpp)
  set_property(TARGET flycast_libretro PROPERTY SOURCES "${sources}")
  target_sources(flycast_libretro PRIVATE "${IRIDIUM_PHASE3_GENERATED}/glsm.c" "${IRIDIUM_PHASE3_GENERATED}/libretro.cpp")
  target_include_directories(flycast_libretro PRIVATE "${CMAKE_SOURCE_DIR}/shell/libretro")
  target_sources(flycast_libretro PRIVATE "${bridge}/IRFlycastProbe.cpp" "${bridge}/IRJITExecutionProbe.c")
  target_include_directories(flycast_libretro PRIVATE "${bridge}")
  target_link_options(flycast_libretro PRIVATE "-Wl,-exported_symbols_list,${IRIDIUM_PHASE3_GENERATED}/retro.exports")
endif()
