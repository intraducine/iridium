foreach(target play_libretro PlayCore app_shared)
  target_include_directories(${target} BEFORE PRIVATE "${IRIDIUM_PHASE3_GENERATED}/include")
endforeach()
get_target_property(sources app_shared SOURCES)
list(REMOVE_ITEM sources AppConfig.cpp Log.cpp)
set_property(TARGET app_shared PROPERTY SOURCES "${sources}")
target_sources(app_shared PRIVATE "${IRIDIUM_PHASE3_GENERATED}/AppConfig.cpp" "${IRIDIUM_PHASE3_GENERATED}/Log.cpp")
get_target_property(sources play_libretro SOURCES)
list(REMOVE_ITEM sources main_libretro.cpp)
set_property(TARGET play_libretro PROPERTY SOURCES "${sources}")
target_sources(play_libretro PRIVATE "${IRIDIUM_PHASE3_GENERATED}/main_libretro.cpp" "${bridge}/IRPlayProbe.cpp" "${bridge}/IRJITExecutionProbe.c")
target_sources(play_libretro PRIVATE "${bridge}/IRSharedJITMemory.cpp")
target_include_directories(play_libretro PRIVATE "${bridge}" "${CMAKE_SOURCE_DIR}/Source/ui_libretro")
get_target_property(sources CodeGen SOURCES)
list(REMOVE_ITEM sources src/MemoryFunction.cpp)
set_property(TARGET CodeGen PROPERTY SOURCES "${sources}")
target_sources(CodeGen PRIVATE "${IRIDIUM_PHASE3_GENERATED}/MemoryFunction.cpp")
target_include_directories(CodeGen PRIVATE "${bridge}")
get_target_property(sources PlayCore SOURCES)
list(REMOVE_ITEM sources BasicBlock.cpp)
set_property(TARGET PlayCore PROPERTY SOURCES "${sources}")
target_sources(PlayCore PRIVATE "${IRIDIUM_PHASE3_GENERATED}/BasicBlock.cpp")
target_include_directories(PlayCore PRIVATE "${bridge}" "${CMAKE_SOURCE_DIR}/Source")
target_link_options(play_libretro PRIVATE "-Wl,-exported_symbols_list,${IRIDIUM_PHASE3_GENERATED}/retro.exports")
