+ * a 1 GiB arena. Large classes that cannot fit with their header use the
+ * already-supported huge mapping path; do not create a zero-block page. */
+static const char ios_span4_marker[] __attribute__((used)) = "rpmalloc-span4 rev=iridium-compact";
+#define SPAN_SIZE (4 * 1024 * 1024)
 #else
 #define SPAN_SIZE (256 * 1024 * 1024)
