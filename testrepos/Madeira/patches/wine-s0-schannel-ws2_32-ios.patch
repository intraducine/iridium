         ERR_(winediag)("Failed to load libgnutls, secure connections will not be available.\n");
@@ -1485,6 +1491,7 @@ static NTSTATUS process_attach( void *args )
 #define LOAD_FUNCPTR(f) \
     if (!(p##f = dlsym(libgnutls_handle, #f))) \
